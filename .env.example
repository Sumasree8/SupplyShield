# SupplyShield AI — Environment Configuration Template
# Copy to .env and fill in all required values before starting.
# NEVER commit .env to source control.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# 64-char random hex: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# PostgreSQL
POSTGRES_USER=ss_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────

# Environment
ENVIRONMENT=production

# Redis
REDIS_PASSWORD=CHANGE_ME

# Domain (for CORS)
DOMAIN=yourdomain.com

# External Risk Intelligence APIs
# NOAA Weather Alerts: https://www.weather.gov/documentation/services-web-api
NOAA_API_KEY=

# OpenWeather: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# News API: https://newsapi.org
NEWS_API_KEY=

# ─── ALERT CHANNELS ──────────────────────────────────────────────────────────

# Slack webhook for alert notifications
SLACK_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── OBSERVABILITY ───────────────────────────────────────────────────────────

# Sentry DSN (optional)
SENTRY_DSN=

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_ME
